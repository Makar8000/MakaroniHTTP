{
  "name": "makaroni-http",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun index.ts",
    "prod": "pm2 start \"bun index.ts\" --name \"makaroni-http\" --log data/Makaroni-HTTP.log",
    "stop": "pm2 stop makaroni-http",
    "monitor": "pm2 logs makaroni-http",
    "restart": "git pull && bun install --frozen-lockfile && pm2 restart makaroni-http --update-env",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "hash-password": "bun util/hash-password.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@fastify/basic-auth": "^6.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "deepl-node": "^1.28.1",
    "discord-api-types": "^0.37.120",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inquirer/prompts": "^8.7.3",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
