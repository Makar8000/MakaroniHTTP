# Basic auth for protected routes
# Use `bun run hash-password` to generate
BASIC_AUTH_HASH=<HASH>

# The Discord Bot token
DISCORD_TOKEN=<TOKEN>
# The Discord Bot application ID
DISCORD_APP_ID=<APP_ID>
# The Discord Bot user ID
DISCORD_USER_ID=<USER_ID>

# The DeepL API Key
DEEPL_API_KEY=<API_KEY>

# Thread ID for testing
THREAD_ID=<CHANNEL_ID>